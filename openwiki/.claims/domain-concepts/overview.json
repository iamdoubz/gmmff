  "claims": [
    {
      "id": "claim_ad1d1658946347a6802bf85b99b42169",
      "statement": "A slot in gmmff progresses through the lifecycle states: Waiting (created, awaiting peers), Active (at least one peer joined, still accepting), Full (maximum peers reached), and Closed (session ended via disconnect, initiator departure, or TTL expiry).",
      "evidence": [
        {
          "resource": "repo://internal/slot/slot.go#L24-L146",
          "version": "repo-lines-v1:sha256:231b006b60a92c3cdf8483ca93e5b14ac3ea0c4410d8240354086c2521844225:"
        }
      ]
    },
    {
      "id": "claim_115a68020b164ceb892a70cc27ce0961",
      "statement": "The slot state machine prevents invalid transitions: Waiting → Active on peer join, Active → Full when max peers reached (setting EverFull=true), Active/Full → Closed on close/TTL/initiator departure, and Active → Waiting when last peer leaves and EverFull is false.",
      "evidence": [
        {
          "resource": "repo://internal/slot/slot.go#L97-L146",
          "version": "repo-lines-v1:sha256:16fd20abbe6c8ed4bb72faf3f9453dd329e8a074faa18567b9fd3f44d2c98568:"
        }
      ]
    },
    {
      "id": "claim_8a82f359a20b4f5490dc6241a17cda21",
      "statement": "gmmff uses the CPace PAKE protocol to establish a shared secret from a low-entropy 3-word code, providing mutual authentication, key derivation, server obliviousness, and resistance to offline dictionary attacks.",
      "evidence": [
        {
          "resource": "repo://internal/pake/session.go#L1-L16",
          "version": "repo-lines-v1:sha256:cfac49cd87fb71ddfe72d25d1e7af9add243f9bcb657a6b414b631c718f2a3fc:"
        }
      ]
    },
    {
      "id": "claim_2700475ba21f468ead96c8172ab54875",
      "statement": "After CPace completes, gmmff derives two HKDF-SHA256 subkeys from the shared secret: offerKey for signing/verifying SDP offers and answerKey for signing/verifying SDP answers, preventing SDP tampering by attackers who lack the shared secret.",
